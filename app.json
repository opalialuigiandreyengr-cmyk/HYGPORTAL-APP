{
  "expo": {
    "name": "HYG Portal",
    "slug": "hyg-portal",
    "version": "1.7.2",
    "orientation": "portrait",
    "icon": "./assets/hygapplogo.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/b0a75d0f-14f4-432f-a404-9b2a62805c4d"
    },
    "ios": {
      "buildNumber": "22",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Allow HYG Portal to access your camera for employee photo proof.",
        "NSLocationWhenInUseUsageDescription": "Allow HYG Portal to access your location to verify photo proof address.",
        "NSPhotoLibraryAddUsageDescription": "Allow HYG Portal to save photo proofs to your photo library."
      }
    },
    "android": {
      "package": "com.hyg.portal",
      "versionCode": 30,
      "googleServicesFile": "./google-services.json",
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.REQUEST_INSTALL_PACKAGES",
        "android.permission.CAMERA"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/hygapplogo-adaptive.png",
        "backgroundColor": "#071426"
      },
      "edgeToEdgeEnabled": false,
      "navigationBarColor": "#071426",
      "navigationBarDividerColor": "#071426",
      "navigationBarIconStyle": "light",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "dangerous": {
        "production": {
          "serviceWorker": {
            "register": true
          }
        }
      }
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-mlkit-ocr",
      "expo-sqlite",
      "expo-secure-store",
      "expo-local-authentication",
      "expo-notifications",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow HYG Portal to access your camera for employee photo proof."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow HYG Portal to access your location to verify photo proof address."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "b0a75d0f-14f4-432f-a404-9b2a62805c4d"
      }
    }
  }
}
