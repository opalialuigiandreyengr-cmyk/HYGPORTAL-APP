{
  "buildCommand": "npm run build:web",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/hygportal.apk",
      "destination": "https://expo.dev/artifacts/eas/bIdCf-K_HAxiTjI4fymDsZYP541q1e9mjHaNsmZjgok.apk",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/.well-known/(.*)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/inventory/store_inventory_data",
      "destination": "https://luigiandreyopalia.pythonanywhere.com/inventory/store_inventory_data"
    },
    {
      "source": "/employees/store_employee_data",
      "destination": "/api/employees/store_employee_data"
    },
    {
      "source": "/employees",
      "destination": "/api/employees"
    },
    {
      "source": "/employees/sync",
      "destination": "/api/employees/store_employee_data"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
